# Copy to .env.local and fill in from Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Server only. Never prefix this with NEXT_PUBLIC_. Lets the site save suburb
# map locations. Optional: without it, locations are looked up again after
# each restart.
# SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# Google Maps. The browser key shows the suburb map. Restrict it in Google Cloud
# to your website addresses, with the Maps JavaScript API enabled.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIza_browser_key

# Server only. Never prefix this with NEXT_PUBLIC_. Looks up suburb locations
# with the Geocoding API. Enable the Geocoding API on this key.
# GOOGLE_MAPS_API_KEY=AIza_server_key
